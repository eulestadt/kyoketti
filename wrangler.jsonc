{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kyoketti",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
